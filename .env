# LuminalLib Development Environment Configuration
# This is for LOCAL DEVELOPMENT with Docker

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=luminallib_db
DB_HOST=postgres
DB_PORT=5432

# ============================================================
# BACKEND CONFIGURATION
# ============================================================
ENVIRONMENT=development
DEBUG=True
BACKEND_PORT=8000

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
FRONTEND_PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# SECURITY CONFIGURATION (Development - NOT for production!)
# ============================================================
SECRET_KEY=dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================
# CORS CONFIGURATION
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8000

# ============================================================
# LLM PROVIDER CONFIGURATION
# ============================================================
# Use 'mock' for testing without API keys
LLM_PROVIDER=ollama
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ============================================================
# STORAGE CONFIGURATION
# ============================================================
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/files

# ============================================================
# DOCKER CONFIGURATION
# ============================================================
COMPOSE_PROJECT_NAME=luminallib-dev
ADMINER_PORT=8080
